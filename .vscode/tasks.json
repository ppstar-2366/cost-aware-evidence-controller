      "args": [
        "${workspaceFolder}/src/bootstrap_retrieval.py",
        "--output-dir",
        "${workspaceFolder}/outputs/test416",
        "--run-name",
        "test416",
        "--replicates",
        "5000",
        "--seed",
        "42"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Audit: Verify held-out artifacts",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/src/audit_test_experiment.py",
