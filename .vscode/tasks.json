{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Compile sources",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "compileall", "-q", "${workspaceFolder}/src"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "QASPER: Build held-out test split",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/src/build_evidence_units.py",
        "--splits",
        "test",
        "--test-output",
        "${workspaceFolder}/data/processed/qasper_test_416.jsonl",
        "--dataset-revision",
        "13b496d2a5359329b110e3419628de3cf791843b"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Experiment: Run held-out retrieval",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/src/run_retrieval_experiment.py",
        "--input",
        "${workspaceFolder}/data/processed/qasper_test_416.jsonl",
        "--output-dir",
        "${workspaceFolder}/outputs/test416",
        "--run-name",
        "test416",
        "--threshold",
        "0.5",
        "--top-k",
        "1",
        "3",
        "5",
        "7",
        "8",
        "10",
        "20"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
